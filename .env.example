# =========================
# Django / Site
# =========================
SITE_ENVIRONMENT=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=COLE_UMA_SECRET_KEY_FORTE_AQUI
DJANGO_ALLOWED_HOSTS=ncfly.com.br,www.ncfly.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://ncfly.com.br,https://www.ncfly.com.br
DJANGO_SECURE_SSL_REDIRECT=True

SITE_BASE_URL=https://ncfly.com.br
PORTAL_SITE_NAME=NC Fly News
PORTAL_SITE_LOGO_URL=/static/portal/img/nacari-fly-logo.webp
PORTAL_SITE_LOGO_LIGHT_URL=/static/portal/img/nacari-fly-logo.webp
PORTAL_SITE_FAVICON_URL=/static/portal/img/nacari-fly-favicon.png
PORTAL_DEFAULT_META_DESCRIPTION=Portal da NC Fly com noticias, promocoes, milhas, cartoes de credito, hoteis e estrategias para viajar melhor.
PORTAL_LEGAL_ENTITY_NAME=NC Fly

# =========================
# Database
# =========================
DATABASE_URL=COLE_A_DATABASE_URL_DO_RAILWAY_AQUI
# Se DATABASE_URL existir, DB_ENGINE pode ser ignorado.
DB_ENGINE=sqlite

# =========================
# Seguranca / Login
# =========================
SECURITY_LOGIN_FAILURE_LIMIT=5
SECURITY_LOGIN_LOCKOUT_MINUTES=15
SECURITY_PASSWORD_RESET_LIMIT=3
SECURITY_PASSWORD_RESET_LOCKOUT_MINUTES=30
PASSWORD_RESET_TIMEOUT=7200
SUPERADMIN_MFA_ENABLED=True
SUPERADMIN_MFA_CODE_TTL_MINUTES=10
SUPERADMIN_MFA_ATTEMPT_LIMIT=5
TURNSTILE_SITE_KEY=COLE_A_SITE_KEY_DO_CLOUDFLARE_TURNSTILE
TURNSTILE_SECRET_KEY=COLE_A_SECRET_KEY_DO_CLOUDFLARE_TURNSTILE
TURNSTILE_FAIL_OPEN=False

# =========================
# Media / Static
# =========================
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT=/app/media

# =========================
# Analytics / Search Console
# =========================
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_VERIFICATION=

# =========================
# Empresa / Contato
# =========================
PORTAL_CONTACT_EMAIL=atendimento@ncfly.com.br
PORTAL_PARTNERSHIP_EMAIL=parceria@ncfly.com.br
PORTAL_DPO_EMAIL=atendimento@ncfly.com.br
PORTAL_CONTACT_PHONE=12991722902
PORTAL_CONTACT_WHATSAPP=12991722902
PORTAL_COMPANY_CNPJ=66.162.952/0001-10
PORTAL_COMPANY_ADDRESS=

# =========================
# Email SMTP
# =========================
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=10
DJANGO_EMAIL_HOST_USER=COLE_O_EMAIL_QUE_VAI_AUTENTICAR_NO_SMTP
DJANGO_EMAIL_HOST_PASSWORD=COLE_A_SENHA_DE_APP_OU_SENHA_SMTP
DJANGO_DEFAULT_FROM_EMAIL=alertas@ncfly.com.br

# =========================
# Email via Resend API (recomendado no Railway Hobby)
# =========================
RESEND_API_KEY=COLE_A_API_KEY_DO_RESEND
RESEND_FROM_EMAIL=alertas@ncfly.com.br
RESEND_API_URL=https://api.resend.com/emails
RESEND_REQUEST_TIMEOUT=15

# =========================
# Emails de alertas / leads
# =========================
PORTAL_ALERTS_FROM_EMAIL=alertas@ncfly.com.br
PORTAL_ALERTS_REPLY_TO=atendimento@ncfly.com.br
PORTAL_LEAD_NOTIFICATION_RECIPIENTS=pdrnacari@gmail.com

# =========================
# Cookies
# =========================
PORTAL_COOKIE_CONSENT_COOKIE_NAME=ncfly_cookie_preferences
PORTAL_COOKIE_CONSENT_VERSION=2026-04
PORTAL_COOKIE_CONSENT_MAX_AGE_DAYS=180

# =========================
# OpenAI / Noticias
# =========================
OPENAI_API_KEY=COLE_SUA_CHAVE_OPENAI_AQUI
OPENAI_NEWS_MODEL=gpt-5.4
OPENAI_NEWS_IMAGE_MODEL=gpt-image-1.5
PORTAL_NEWS_CONFIDENCE_THRESHOLD=0.70
PORTAL_GENERATE_AI_IMAGES=0
PORTAL_FORCE_AI_IMAGES=0
PORTAL_USE_SOURCE_IMAGE_REFERENCE=1

# =========================
# Telegram / Alertas
# =========================
TELEGRAM_ALERTS_BOT_TOKEN=COLE_O_TOKEN_DO_BOT_DE_ALERTAS
TELEGRAM_ALERTS_WEBHOOK_SECRET=COLE_UM_SECRET_DO_BOT_DE_ALERTAS
TELEGRAM_ALERTS_ALLOWED_CHAT_IDS=COLE_O_CHAT_ID_AUTORIZADO

# =========================
# Telegram / Noticias
# =========================
TELEGRAM_NEWS_BOT_TOKEN=COLE_O_TOKEN_DO_BOT_DE_NOTICIAS
TELEGRAM_NEWS_WEBHOOK_SECRET=COLE_UM_SECRET_DO_BOT_DE_NOTICIAS
TELEGRAM_NEWS_ALLOWED_CHAT_IDS=COLE_O_CHAT_ID_AUTORIZADO

# =========================
# Railway cron jobs (UTC)
# =========================
# 08:00 BRT -> 11:00 UTC
# python manage.py send_alert_email_digest --remaining-slots 4
#
# 12:00 BRT -> 15:00 UTC
# python manage.py send_alert_email_digest --remaining-slots 3
#
# 15:00 BRT -> 18:00 UTC
# python manage.py send_alert_email_digest --remaining-slots 2
#
# 20:00 BRT -> 23:00 UTC
# python manage.py send_alert_email_digest --remaining-slots 1
